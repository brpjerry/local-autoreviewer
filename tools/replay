#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-3.0-or-later
"""Replay a review of an earlier commit of a PR, optionally with other prompts, to compare prompt changes.

  tools/replay owner/repo#N COMMIT [--base-sha SHA] [--agent claude|codex] [--prompts DIR] [--json]

COMMIT and the base commit must still be in the service's mirror of the repository. It keeps open PRs' current
heads and bases and the commits of unexpired job checkouts; housekeeping drops a closed PR's refs. The review
runs through the real pipeline against a scratch copy laid out like GitHub, in a scratch state directory, and
is never posted. Only the PR's title, description, author and base branch are read from GitHub. --prompts
names a directory with review.md and review.schema.json (default: this checkout's prompts/).

Codex runs with the reviews' own login (the live CODEX_HOME), and a plain run includes it when the repo's
config does. So a replay that includes Codex refuses to start while the service is running a Codex review,
and holds off the service's Codex reviews until it exits (pass --agent claude to leave them alone).
"""

import argparse
import atexit
import fcntl
import json
import os
import signal
import sqlite3
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "src"))

from local_autoreviewer import config as config_mod  # noqa: E402
from local_autoreviewer import db, leakscan, paths, pipeline  # noqa: E402
from local_autoreviewer.__main__ import CliError, auth_files, parse_ref  # noqa: E402
from local_autoreviewer.github import GitHub, GitHubError, read_token  # noqa: E402
from local_autoreviewer.gitops import Git, GitError  # noqa: E402
from local_autoreviewer.runner import make_runner  # noqa: E402


class ReplayGitHub:
    """Answers the pipeline's questions about the PR as if HEAD were still its head. Posts nothing."""

    def __init__(self, pr, head):
        self.pr = {**pr, "headRefOid": head, "state": "OPEN", "isDraft": False}

    def pr_view(self, repo, number):
        return dict(self.pr)

    def post_review(self, *args, **kwargs):
        raise RuntimeError("replay never posts")


ENV = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": os.environ.get("HOME", "/")}


def hold_codex(live_state):
    """Keep the service from starting a Codex review while this replay may use the shared login (a hold;
    see worker.held_agents). It lasts until the process exits."""
    holds = live_state / "holds"
    holds.mkdir(exist_ok=True)
    path = holds / f"replay-{os.getpid()}.lock"
    handle = open(path, "w")
    fcntl.flock(handle, fcntl.LOCK_EX)
    handle.write("codex\n")
    handle.flush()
    atexit.register(lambda: (path.unlink(missing_ok=True), handle.close()))
    return handle


def git(*args):
    """git with the service's hardening (no user config, hooks or signing); GitError on failure."""
    return Git(str(ROOT), ENV).out(list(args))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("ref", help="owner/repo#N")
    parser.add_argument("head", help="the PR commit to review")
    parser.add_argument("--base-sha", help="the base commit (default: the one the service last fetched)")
    parser.add_argument("--agent", action="append", choices=config_mod.AGENTS,
                        help="agent to run; repeatable (default: the repo's configured agents)")
    parser.add_argument("--prompts", type=Path, help="directory with review.md and review.schema.json")
    parser.add_argument("--json", action="store_true", help="print the structured reviews")
    args = parser.parse_args()
    if args.prompts:
        missing = [name for name in ("review.md", "review.schema.json") if not (args.prompts / name).is_file()]
        if missing:
            sys.exit(f"tools/replay: {args.prompts} has no {' or '.join(missing)}")

    repo, number = parse_ref(args.ref)
    live_state = paths.state_dir()
    cfg = config_mod.load(paths.config_file())
    repo_cfg = cfg.repo(repo)
    if repo_cfg is None:
        sys.exit(f"tools/replay: {repo} is not in the config")
    mirror = Git("https://github.com", {}).mirror_path(live_state, repo)
    head = git("-C", str(mirror), "rev-parse", "--verify", f"{args.head}^{{commit}}")
    base = args.base_sha or f"refs/autoreview/pr/{number}/base"
    base_sha = git("-C", str(mirror), "rev-parse", "--verify", f"{base}^{{commit}}")
    token = read_token(paths.token_file())
    pr = GitHub(token, live_state / "gh").pr_view(repo, number)

    scratch = Path(tempfile.mkdtemp(prefix="local-autoreviewer-replay-"))
    print(f"scratch directory (remove it when done): {scratch}", file=sys.stderr, flush=True)
    remote = scratch / "remote" / f"{repo_cfg.name}.git"  # the name the pipeline's origin URL uses
    git("init", "--quiet", "--bare", "--template=", str(remote))
    # Borrow the mirror's objects instead of copying its whole history.
    (remote / "objects" / "info").mkdir(parents=True, exist_ok=True)
    (remote / "objects" / "info" / "alternates").write_text(f"{mirror.resolve() / 'objects'}\n")
    git("-C", str(remote), "update-ref", f"refs/pull/{number}/head", head)
    git("-C", str(remote), "update-ref", f"refs/heads/{pr['baseRefName']}", base_sha)
    state = scratch / "state"
    state.mkdir()
    (state / "codex-home").symlink_to(live_state / "codex-home")
    os.environ.pop("LOCAL_AUTOREVIEWER_SHARE", None)  # default: this checkout's prompts/
    if args.prompts:
        share = scratch / "share"
        share.mkdir()
        (share / "prompts").symlink_to(args.prompts.resolve())
        os.environ["LOCAL_AUTOREVIEWER_SHARE"] = str(share)

    svc = pipeline.Services(
        config=cfg, state=state, github=ReplayGitHub(pr, head), git=Git(str(scratch / "remote"), ENV),
        runner=make_runner(), token_owner="",  # only used for posting, which a replay never does
        secrets=lambda: [token, *leakscan.collect_secrets(auth_files(live_state))])
    # Scratch job ids start at 1 in every replay: keep their scopes apart from other replays' and the service's.
    pipeline.scope_unit = lambda job_id: f"local-autoreviewer-replay-{os.getpid()}-{job_id}"
    agents = list(dict.fromkeys(args.agent or repo_cfg.agents))  # a repeat would hit the jobs' UNIQUE key
    if "codex" in agents:  # a shared CODEX_HOME races the service's token refreshes (see above)
        hold = hold_codex(live_state)  # first, so the worker can't start one after the check below  # noqa: F841
        try:
            live = sqlite3.connect(f"{(live_state / 'state.sqlite3').resolve().as_uri()}?mode=ro", uri=True)
            try:
                busy = live.execute("SELECT COUNT(*) FROM jobs WHERE agent='codex' AND status='running'").fetchone()[0]
            finally:
                live.close()
        except sqlite3.Error:
            busy = 0  # no service database yet
        if busy:
            sys.exit("tools/replay: the service is running a Codex review; wait for it or pass --agent claude")
    reviews = {}
    for agent in agents:
        conn = svc.connect()
        with db.transaction(conn):
            job_id = db.insert_job(conn, repo=repo_cfg.name, number=number, head_sha=head, base_ref=pr["baseRefName"],
                                   agent=agent, model=cfg.agents[agent].model, source=db.FOREGROUND, not_before=0,
                                   now=svc.now(), post=False)
            db.update_job(conn, job_id, status="running", started_at=svc.now())
        conn.close()
        status = pipeline.run_job(svc, job_id, pipeline.CancelToken())
        out = Path(pipeline.job_paths(state, job_id).out)
        # A finished, unposted review ends 'skipped' with review.md written after validation; a raw review.json
        # from an agent that then failed doesn't count.
        if status != "skipped" or not (out / "review.md").is_file():
            conn = svc.connect()
            reason = db.get_job(conn, job_id)["reason"]
            conn.close()
            print(f"{agent}: {status}, no completed review: {reason} (see {out})", file=sys.stderr)
            continue
        reviews[agent] = json.loads((out / "review.json").read_text())
        if not args.json:
            print(f"== {agent} ({status}; {out / 'review.md'})")
            for n, item in enumerate(reviews[agent]["findings"], 1):
                moved = f" (from {item['reviewer_severity']})" if item["severity"] != item["reviewer_severity"] else ""
                print(f"{n:>3}. {item['severity']}{moved} {item['impact']}/10 {item['likelihood']:<10} "
                      f"{item['title'][:110]}")
            print(f"     test gaps {len(reviews[agent]['test_gaps'])}, questions {len(reviews[agent]['questions'])}, "
                  f"nits {len(reviews[agent]['nits'])}")
    if args.json:
        print(json.dumps(reviews, indent=2))
    return 0 if len(reviews) == len(agents) else 1


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, signal.default_int_handler)  # stop the agent as Ctrl-C does
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (CliError, GitError, GitHubError, config_mod.ConfigError) as exc:
        sys.exit(f"tools/replay: {exc}")
