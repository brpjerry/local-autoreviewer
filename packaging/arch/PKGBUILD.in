# Generated by prepare.py from the checked-out source, without network downloads.
pkgname=local-autoreviewer
pkgver=@VERSION@
pkgrel=1
pkgdesc='Review your GitHub pull requests with local Claude Code and Codex sessions'
arch=('any')
url='https://github.com/brpjerry/local-autoreviewer'
license=('GPL-3.0-or-later')
depends=('python' 'git' 'github-cli' 'systemd')
optdepends=('claude-code: Claude Code reviews'
            'openai-codex: Codex reviews')
source=('local-autoreviewer.tar.gz')
sha256sums=('@SHA256@')

check() {
  cd "$srcdir/local-autoreviewer"
  # Offline: fake agents, a local Git remote and a fake GitHub API.
  python -I -m unittest discover -s tests -t .
}

package() {
  cd "$srcdir/local-autoreviewer"
  # A private module directory instead of site-packages, so a Python minor-version
  # upgrade does not strand the package.
  install -d "$pkgdir/usr/lib/local-autoreviewer"
  cp -r --no-preserve=ownership,mode src/local_autoreviewer "$pkgdir/usr/lib/local-autoreviewer/"
  find "$pkgdir/usr/lib/local-autoreviewer" -name __pycache__ -prune -exec rm -rf {} +
  find "$pkgdir/usr/lib/local-autoreviewer" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/lib/local-autoreviewer" -type f -exec chmod 644 {} +
  install -Dm755 bin/local-autoreviewer "$pkgdir/usr/bin/local-autoreviewer"
  install -Dm644 -t "$pkgdir/usr/share/local-autoreviewer/prompts" \
    prompts/review.md prompts/review.schema.json prompts/followup.md
  # The worker restarts itself, once idle, when this changes after an upgrade.
  printf '%s-%s\n' "$pkgver" "$pkgrel" > "$pkgdir/usr/share/local-autoreviewer/VERSION"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" systemd/autoreviewer.slice \
    systemd/local-autoreviewer-worker.service systemd/local-autoreviewer-poll.service \
    systemd/local-autoreviewer-poll.timer
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md config.example.toml \
    docs/agent-cli-notes.md
  install -Dm644 .source-revision "$pkgdir/usr/share/doc/$pkgname/source-revision"
}
